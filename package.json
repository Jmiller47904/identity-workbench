{
  "name": "identity-workbench",
  "version": "0.2.0",
  "private": true,
  "description": "Local JWT and SAML inspection for identity engineers.",
  "author": "SirSlautty",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "engines": {"node": ">=22.13.0"},
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "build:web": "node scripts/build-web.cjs",
    "desktop": "electron .",
    "desktop:dist": "electron-builder --publish never",
    "build:windows": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "jsdom": "26.1.0"
  },
  "build": {
    "appId": "com.sirslautty.identityworkbench",
    "productName": "Identity Workbench",
    "directories": {"output": "release"},
    "files": ["electron/**", "dist/index.html", "dist/app.js", "dist/style.css", "package.json"],
    "asar": true,
    "publish": null,
    "win": {"target": ["nsis", "portable"], "signAndEditExecutable": false},
    "nsis": {"oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "artifactName": "Identity-Workbench-${version}-Windows-Setup.${ext}"},
    "portable": {"artifactName": "Identity-Workbench-${version}-Windows-Portable.${ext}"},
    "mac": {"target": ["dmg"], "category": "public.app-category.developer-tools"},
    "linux": {"target": ["AppImage"], "category": "Development"}
  }
}
